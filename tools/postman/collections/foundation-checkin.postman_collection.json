            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{API_BASE_URL}}/api/v1/foundation-checkins" }
          },
          "status": "Bad Request",
          "code": 400,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\n  \"error\": {\n    \"code\": \"VALIDATION_ERROR\",\n    \"message\": \"The request contains invalid fields.\",\n    \"details\": [\n      { \"field\": \"name\", \"message\": \"Name is required.\" }\n    ]\n  }\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test('Returns VALIDATION_ERROR for name', function () {",
              "  const error = pm.response.json().error;",
              "  pm.expect(error.code).to.eql('VALIDATION_ERROR');",
              "  pm.expect(error.details[0].field).to.eql('name');",
              "});"
            ]
