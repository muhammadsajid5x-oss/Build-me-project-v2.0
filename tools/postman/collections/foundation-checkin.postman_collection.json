              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\"\n}"
            },
            "url": { "raw": "{{API_BASE_URL}}/api/v1/foundation-checkins" }
          },
          "status": "Created",
          "code": 201,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\n  \"data\": {\n    \"id\": \"b3f1c2d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d\",\n    \"name\": \"Ada Lovelace\",\n    \"createdAt\": \"2026-10-03T10:00:00.000Z\"\n  }\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('Returns id, name and createdAt', function () {",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.id).to.be.a('string');",
              "  pm.expect(data.name).to.eql('Ada Lovelace');",
              "  pm.expect(new Date(data.createdAt).toString()).to.not.eql('Invalid Date');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create check-in with missing name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          { "key": "Accept", "value": "application/json", "type": "text" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{API_BASE_URL}}/api/v1/foundation-checkins" },
        "description": "A missing name is rejected with 400 VALIDATION_ERROR."
      },
      "response": [
        {
          "name": "Validation error",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
