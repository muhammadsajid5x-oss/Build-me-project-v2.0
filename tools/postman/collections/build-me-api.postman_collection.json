{
  "info": {
    "name": "Build Me API",
    "description": "Foundation API requests for Build Me.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Foundation",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{API_BASE_URL}}/health"
            },
            "description": "Checks whether the Build Me API is running. This GET request has no body."
          },
          "response": [
            {
              "name": "Healthy",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{API_BASE_URL}}/health"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "cookie": [],
              "body": "{\n  \"status\": \"ok\",\n  \"service\": \"build-me-api\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health endpoint returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Health response identifies the API', function () {",
                  "  pm.expect(pm.response.json()).to.eql({ status: 'ok', service: 'build-me-api' });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "API_BASE_URL",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
