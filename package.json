{
  "name": "build-me",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "pnpm": {
    "overrides": {
      "qs": "6.16.0",
      "ip-address": "10.7.1"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "storybook": "turbo run storybook --filter=@build-me/ui",
    "build-storybook": "turbo run storybook:build --filter=@build-me/ui",
    "test-storybook": "test-storybook --config-dir packages/ui/.storybook",
    "test:unit": "jest --config tests/jest.config.cjs",
    "cypress:run": "cypress run --config-file tests/cypress.config.js",
    "cypress:open": "cypress open --config-file tests/cypress.config.js",
    "lint": "turbo run lint",
    "test:e2e": "cypress run --config-file tests/cypress.config.js",
    "test:performance": "playwright test tests/performance/homepage.performance.spec.ts",
    "type-check": "turbo run type-check typecheck",
    "test:analytics": "jest --config tests/jest.config.cjs tests/analytics",
    "test:security": "jest --config tests/jest.config.cjs tests/security && playwright test tests/security/api-security.spec.ts",
    "test:api": "jest --config tests/jest.config.cjs tests/api",
    "test:integration": "playwright test tests/integration/api-health.integration.spec.ts"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@storybook/test-runner": "0.24.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "cypress": "^16.0.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "playwright": "^1.62.1",
    "prop-types": "latest",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "storybook": "^10.5.10",
    "supabase": "^2.116.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "turbo": "^2.10.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vercel": "^59.12.0",
    "vitest": "latest"
  }
}
