{
  "name": "@build-me/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./drizzle": "./drizzle/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle/config.ts",
    "db:check": "drizzle-kit check --config=drizzle/config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle/config.ts",
    "db:seed": "tsx seeds/seed.ts"
  },
  "dependencies": {
    "@build-me/utils": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
