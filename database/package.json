{
  "name": "@build-me/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "import": "./dist/drizzle/index.js"
    },
    "./drizzle/client": {
      "types": "./dist/drizzle/client.d.ts",
      "import": "./dist/drizzle/client.js"
    },
    "./schema/analytics-events": {
      "types": "./dist/schema/analytics-events.d.ts",
      "import": "./dist/schema/analytics-events.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle/config.ts",
    "db:check": "drizzle-kit check --config=drizzle/config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle/config.ts",
    "db:seed": "tsx seeds/seed.ts"
  },
  "dependencies": {
    "@build-me/utils": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
